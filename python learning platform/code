        ttk.Combobox(row, textvariable=self.choice, values=[f'Module {i}' for i in range(1,8)], state='readonly', width=25).pack(side='left', padx=(0,8))
        button(row, 'Start Quiz', self.start, C['primary'], 13).pack(side='left')
        self.info = tk.Label(row, text='', bg=C['card'], fg=C['muted'])
        self.info.pack(side='right')
        self.area = card(self)
        self.area.pack(fill='both', expand=True)
        self.question = tk.Label(self.area, text='Ready for your assessment?', bg=C['card'], fg='white', font=('Segoe UI',17,'bold'), wraplength=1000, justify='left')
        self.question.pack(anchor='w', padx=28, pady=25)
        self.options = tk.Frame(self.area, bg=C['card'])
        self.options.pack(fill='x', padx=28)
        self.feedback = tk.Label(self.area, text='', bg=C['card'], fg=C['muted'], font=('Segoe UI',10,'bold'))
        self.feedback.pack(anchor='w', padx=28, pady=18)
        self.next_button = button(self.area, 'Submit', self.next_question, C['primary'], 15)
        self.next_button.pack(anchor='w', padx=28)
        self.next_button.config(state='disabled')

    def start(self):
        self.module = int(self.choice.get().split()[1])
        self.questions = [q for q in QUIZ if q[0] == self.module]
        self.index = 0
        self.score = 0
        self.show_question()

    def show_question(self):
        if self.index >= len(self.questions):
            self.finish()
            return
        _, question, options, correct = self.questions[self.index]
        self.answer.set('')
        self.question.config(text=f'Q{self.index+1}. {question}')
        self.info.config(text=f'{self.index+1}/{len(self.questions)}')
        for widget in self.options.winfo_children():
            widget.destroy()
        for letter, option in zip('ABCD', options):
            tk.Radiobutton(self.options, text=option, variable=self.answer, value=letter, bg=C['card2'], fg='white', selectcolor=C['primary'], anchor='w', font=('Segoe UI',10), pady=8).pack(fill='x', pady=3)
        self.feedback.config(text='')
        self.next_button.config(state='normal', text='Submit')

    def next_question(self):
        if not self.answer.get():
            messagebox.showwarning('Quiz','Select an answer first.')
            return
        if self.answer.get() == self.questions[self.index][3]:
            self.score += 1
            self.feedback.config(text='✓ Correct — good understanding.', fg=C['green'])
        else:
            correct = self.questions[self.index][3]
            self.feedback.config(text=f'✗ Incorrect — review the theory. Correct option: {correct}', fg=C['red'])
        self.index += 1
        self.after(650, self.show_question)

    def finish(self):
        total = len(self.questions)
        percentage = self.score / total * 100 if total else 0
        self.app.db.save_quiz(self.module, self.score, total)
        self.question.config(text=f'Quiz Complete\n\nScore: {self.score}/{total} • {percentage:.0f}%')
        remark = 'Excellent! Keep building applications.' if percentage >= 80 else 'Review the theory and retry the quiz.'
        self.feedback.config(text=remark, fg=C['green'] if percentage >= 80 else C['yellow'])
        self.next_button.config(text='Start Again', command=self.start)


