class Database:
    def __init__(self):
        self.initialize()

    def connect(self):
        db = sqlite3.connect(DB_FILE)
        db.row_factory = sqlite3.Row
        return db

    def initialize(self):
        with self.connect() as db:
            db.execute('CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT UNIQUE, password_hash TEXT, full_name TEXT, created_at TEXT)')
            db.execute('CREATE TABLE IF NOT EXISTS profile(id INTEGER PRIMARY KEY, name TEXT, course TEXT, semester TEXT)')
            db.execute('CREATE TABLE IF NOT EXISTS progress(module INTEGER PRIMARY KEY, completed INTEGER DEFAULT 0, score INTEGER DEFAULT 0, attempts INTEGER DEFAULT 0)')
            db.execute('CREATE TABLE IF NOT EXISTS quiz_results(id INTEGER PRIMARY KEY AUTOINCREMENT, module INTEGER, score INTEGER, total INTEGER, percentage REAL, date TEXT)')
            db.execute('CREATE TABLE IF NOT EXISTS activity(id INTEGER PRIMARY KEY AUTOINCREMENT, action TEXT, details TEXT, date TEXT)')
            default_hash = hashlib.sha256('python123'.encode()).hexdigest()
            db.execute('INSERT OR IGNORE INTO users(username,password_hash,full_name,created_at) VALUES(?,?,?,?)', ('student', default_hash, 'Python Student', datetime.now().strftime('%Y-%m-%d %H:%M:%S')))
            db.execute('UPDATE users SET password_hash=?, full_name=? WHERE username=?', (default_hash, 'Python Student', 'student'))
            db.execute("INSERT OR IGNORE INTO profile VALUES(1,'Learner','BTech CSE AI & ML','Semester 1')")
            for i in range(1, 8):
                db.execute('INSERT OR IGNORE INTO progress(module) VALUES(?)', (i,))

    def create_user(self, full_name, username, password):
        full_name = full_name.strip()
        username = username.strip()
        if not full_name or not username or not password:
            return False, 'Please fill in all fields.'
        if len(username) < 3:
            return False, 'Username must contain at least 3 characters.'
        if len(password) < 4:
            return False, 'Password must contain at least 4 characters.'
        password_hash = hashlib.sha256(password.encode()).hexdigest()
        try:
            with self.connect() as db:
                db.execute(
                    'INSERT INTO users(username,password_hash,full_name,created_at) VALUES(?,?,?,?)',
                    (username, password_hash, full_name, datetime.now().strftime('%Y-%m-%d %H:%M:%S'))
                )
            return True, 'Account created successfully.'
        except sqlite3.IntegrityError:
            return False, 'Username already exists. Choose another username.'

    def authenticate(self, username, password):
        password_hash = hashlib.sha256(password.encode()).hexdigest()
        with self.connect() as db:
            row = db.execute('SELECT * FROM users WHERE username=? AND password_hash=?', (username.strip(), password_hash)).fetchone()
            return dict(row) if row else None

    def profile(self):
        with self.connect() as db:
            row = db.execute('SELECT * FROM profile WHERE id=1').fetchone()
            return dict(row)

    def save_profile(self, name, course, semester):
        with self.connect() as db:
            db.execute('UPDATE profile SET name=?, course=?, semester=? WHERE id=1', (name, course, semester))

    def progress(self):
        with self.connect() as db:
            return [dict(row) for row in db.execute('SELECT * FROM progress ORDER BY module')]

    def complete(self, module):
        with self.connect() as db:
            db.execute('UPDATE progress SET completed=1 WHERE module=?', (module,))

    def save_quiz(self, module, score, total):
        percentage = score / total * 100 if total else 0
        with self.connect() as db:
            db.execute('INSERT INTO quiz_results(module,score,total,percentage,date) VALUES(?,?,?,?,?)', (module, score, total, percentage, datetime.now().isoformat(timespec='seconds')))
            db.execute('UPDATE progress SET score=MAX(score,?), attempts=attempts+1 WHERE module=?', (int(percentage), module))

    def log(self, action, details=''):
        with self.connect() as db:
            db.execute('INSERT INTO activity(action,details,date) VALUES(?,?,?)', (action, details, datetime.now().strftime('%Y-%m-%d %H:%M:%S')))

    def recent(self):
        with self.connect() as db:
            return [dict(row) for row in db.execute('SELECT * FROM activity ORDER BY id DESC LIMIT 12')]

    def summary(self):
        progress = self.progress()
        completed = sum(row['completed'] for row in progress)
        scores = [row['score'] for row in progress if row['score'] > 0]
        attempts = sum(row['attempts'] for row in progress)
        average = sum(scores) / len(scores) if scores else 0
        completion = completed / 7 * 100
        return completed, average, attempts, completion


