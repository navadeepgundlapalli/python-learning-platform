# ---------------------------------------------------------------------------
# Motion & theme engine — small, dependency-free helpers that give the app a
# "live" feel: animated hover states, a sliding sidebar indicator, animated
# page transitions and a soft window fade-in. Pure tkinter, no external libs.
# ---------------------------------------------------------------------------

def _hex_to_rgb(h):
    h = h.lstrip('#')
    if len(h) != 6:
        return (124, 92, 252)
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))

def _rgb_to_hex(rgb):
    return '#%02X%02X%02X' % tuple(max(0, min(255, int(round(c)))) for c in rgb)

def _lighten(hex_color, amount=0.16):
    r, g, b = _hex_to_rgb(hex_color)
    r += (255 - r) * amount
    g += (255 - g) * amount
    b += (255 - b) * amount
    return _rgb_to_hex((r, g, b))

def _animate_bg(widget, target_hex, steps=6, delay=13):
    """Smoothly tween a widget's background colour to target_hex."""
    try:
        current = widget.cget('bg')
    except tk.TclError:
        return
    if not str(current).startswith('#'):
        try:
            widget.config(bg=target_hex)
        except tk.TclError:
            pass
        return
    c0, c1 = _hex_to_rgb(current), _hex_to_rgb(target_hex)
    token = getattr(widget, '_anim_token', 0) + 1
    widget._anim_token = token

    def step(i=0):
        if not widget.winfo_exists() or getattr(widget, '_anim_token', None) != token:
            return
        t = i / steps
        rgb = tuple(c0[k] + (c1[k] - c0[k]) * t for k in range(3))
        try:
            widget.config(bg=_rgb_to_hex(rgb))
        except tk.TclError:
            return
        if i < steps:
            widget.after(delay, lambda: step(i + 1))
    step()

def _hover_enter(event):
    w = event.widget
    try:
        if str(w.cget('state')) == 'disabled':
            return
    except tk.TclError:
        pass
    base = getattr(w, '_base_bg', None)
    if base is None:
        try:
            base = w.cget('bg')
        except tk.TclError:
            return
        w._base_bg = base
    if str(base).startswith('#'):
        _animate_bg(w, _lighten(base, 0.16))

def _hover_leave(event):
    w = event.widget
    base = getattr(w, '_base_bg', None)
    if base and str(base).startswith('#'):
        _animate_bg(w, base)

def _bind_hover_animations(root):
    """App-wide hover glow for every classic tk.Button, applied once per
    Tk/Toplevel interpreter via bind_class (no per-button wiring needed)."""
    root.bind_class('Button', '<Enter>', _hover_enter, add='+')
    root.bind_class('Button', '<Leave>', _hover_leave, add='+')

def _animate_place(widget, steps=9, delay=11, **target):
    """Ease a place()-managed widget's geometry toward target kwargs."""
    try:
        info = widget.place_info()
        start = {k: float(info.get(k) or target[k]) for k in target}
    except Exception:
        try:
            widget.place_configure(**target)
        except tk.TclError:
            pass
        return
    token = getattr(widget, '_move_token', 0) + 1
    widget._move_token = token

    def step(i=0):
        if not widget.winfo_exists() or getattr(widget, '_move_token', None) != token:
            return
        t = i / steps
        t = 1 - (1 - t) ** 3  # ease-out cubic
        cur = {k: start[k] + (target[k] - start[k]) * t for k in target}
        try:
            widget.place_configure(**cur)
        except tk.TclError:
            return
        if i < steps:
            widget.after(delay, lambda: step(i + 1))
    step()

def fade_in_window(win, steps=14, delay=14, target=1.0):
    """Soft fade-in for a whole Tk/Toplevel window (login splash, app open)."""
    try:
        win.attributes('-alpha', 0.0)
    except tk.TclError:
        return
    def step(i=0):
        try:
            win.attributes('-alpha', target * (i / steps))
        except tk.TclError:
            return
        if i < steps:
            win.after(delay, lambda: step(i + 1))
        else:
            try:
                win.attributes('-alpha', target)
            except tk.TclError:
                pass
    step()

def progress_bar(parent, percent, color, width=140, height=7, bg=None):
    """A tiny animated horizontal progress bar (fills from 0 -> percent)."""
    bg = bg or C['card2']
    canvas = tk.Canvas(parent, width=width, height=height, bg=bg, highlightthickness=0, bd=0)
    canvas.create_rectangle(0, 0, width, height, fill=bg, outline='')
    fill = canvas.create_rectangle(0, 0, 0, height, fill=color, outline='')
    target_w = max(0.0, min(1.0, percent / 100.0)) * width
    steps = 16

    def step(i=0):
        if not canvas.winfo_exists():
            return
        t = i / steps
        t = 1 - (1 - t) ** 3
        try:
            canvas.coords(fill, 0, 0, target_w * t, height)
        except tk.TclError:
            return
        if i < steps:
            canvas.after(14, lambda: step(i + 1))
    canvas.after(80, step)
    return canvas

class Runner:
    @staticmethod
    def run(code):
        try:
            ast.parse(code)
        except SyntaxError as error:
            return f'SYNTAX ERROR - line {error.lineno}: {error.msg}'
        path = None
        try:
            with tempfile.NamedTemporaryFile('w', suffix='.py', delete=False, encoding='utf-8') as file:
                file.write(code)
                path = file.name
            result = subprocess.run([sys.executable, path], input='\n', capture_output=True, text=True, timeout=8, cwd=str(BASE))
            output = result.stdout
            if result.stderr:
                output += '\nERROR:\n' + result.stderr
            return output.strip() or 'Program finished without output.'
        except subprocess.TimeoutExpired:
            return 'EXECUTION TIMEOUT - check loops and input.'
        except Exception as error:
            return 'RUNNER ERROR - ' + str(error)
        finally:
            if path:
                try:
                    os.remove(path)
                except OSError:
                    pass


