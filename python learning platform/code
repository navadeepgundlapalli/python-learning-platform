    def show_page(self, name):
        clear_frame(self.content)
        for page, b in self.navigation.items():
            active = page == name
            bg = C['sidebar2'] if active else C['sidebar']
            b.config(relief='flat', bg=bg, fg=C['text'] if active else C['muted'])
            b._base_bg = bg
        self._move_nav_indicator(name)
        subtitles = {
            'Dashboard': 'Learning progress and activity.',
            'Learn': 'Theory, examples and practice tasks.',
            'Practice': 'Python coding and execution.',
            'Quiz': 'Module assessment.',
            'Mini Applications': 'Practical Python applications.',
            'Progress': 'Completion, scores and attempts.',
            'Reports': 'Reports and data export.',
            'Search': 'Search learning content.',
            'Profile': 'Learner information.',
            'About Project': 'Project information.',
        }
        classes = {
            'Dashboard': DashboardPage,
            'Learn': LearnPage,
            'Practice': PracticePage,
            'Quiz': QuizPage,
            'Mini Applications': MiniApplicationsPage,
            'Progress': ProgressPage,
            'Reports': ReportsPage,
            'Search': SearchPage,
            'Profile': ProfilePage,
            'About Project': AboutPage,
        }
        self.page_title.config(text=name)
        self.page_subtitle.config(text=subtitles[name])
        self.current_page = classes[name](self.content, self)
        # Slide the new page in from the right instead of snapping into view.
        self.current_page.place(x=28, y=0, relwidth=1, relheight=1)
        _animate_place(self.current_page, x=0, y=0, relwidth=1, relheight=1)
        self.db.log('Opened page', name)

    def _move_nav_indicator(self, name):
        btn = self.navigation.get(name)
        if not btn:
            return
        self.sidebar.update_idletasks()
        _animate_place(self.nav_indicator, y=btn.winfo_y(), height=btn.winfo_height())


