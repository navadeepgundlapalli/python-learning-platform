        self.status = tk.Label(frame, text='', bg=C['card'], fg=C['red'], font=('Segoe UI', 9))
        self.status.pack(anchor='w', pady=8)

        tk.Button(frame, text='SIGN IN', command=self.login, width=25, height=2, bg=C['primary'], fg='white', activebackground=C['purple'], relief='flat', font=('Segoe UI', 10, 'bold'), cursor='hand2').pack(pady=(8, 7))
        tk.Button(frame, text='CREATE NEW ACCOUNT', command=self.open_register, width=25, height=2, bg=C['card2'], fg=C['cyan'], activebackground=C['border'], activeforeground='white', relief='flat', font=('Segoe UI', 9, 'bold'), cursor='hand2').pack(pady=4)

        tk.Label(frame, text='Default login  •  student / python123', bg=C['card'], fg=C['muted'], font=('Segoe UI', 8)).pack(pady=14)
        user.focus_set()

    def _set_logo_icon(self):
        try:
            self._window_icon = tk.PhotoImage(data=LOGO_ICON_B64)
            self.iconphoto(True, self._window_icon)
        except tk.TclError:
            pass

    def toggle_password(self):
        self.pass_entry.config(show='' if self.show_password.get() else '*')

    def open_register(self):
        RegisterWindow(self)

    def login(self):
        username = self.username.get().strip()
        password = self.password.get()
        if not username or not password:
            self.status.config(text='Enter both username and password.', fg='red')
            return
        user = self.db.authenticate(username, password)
        if not user:
            self.status.config(text='Invalid username or password.', fg='red')
            self.password.set('')
            return
        self.db.log('Signed in', username)
        self.withdraw()
        self.app = App(user, self)
        self.app.mainloop()

    def show_login(self, username=''):
        self.username.set(username)
        self.password.set('')
        self.status.config(text='Account ready. Enter your password.', fg='green' if username else 'red')
        self.deiconify()
        self.lift()
        self.focus_force()
        self.bind('<Return>', lambda event: self.login())
        fade_in_window(self)

    def close_login(self):
        if self.app is not None:
            try:
                self.app.destroy()
            except tk.TclError:
                pass
        self.destroy()


class RegisterWindow(tk.Toplevel):
    def __init__(self, login_page):
        super().__init__(login_page)
        apply_theme(self)
        self.login_page = login_page
        self.db = login_page.db
        self.title(APP_NAME + ' - Create Account')
        self.geometry('500x500')
        self.resizable(False, False)
        self.transient(login_page)
        self.protocol('WM_DELETE_WINDOW', self.back_to_login)

        self.full_name = tk.StringVar()
        self.username = tk.StringVar()
        self.password = tk.StringVar()
        self.confirm = tk.StringVar()

        self.build()
        self.grab_set()
        self.lift()
        self.focus_force()
        fade_in_window(self)

    def build(self):
        frame = tk.Frame(self, bg=C['card'], padx=42, pady=30, highlightthickness=1, highlightbackground=C['border'])
        frame.pack(fill='both', expand=True, padx=20, pady=20)

        tk.Label(frame, text='CREATE ACCOUNT', bg=C['card'], fg=C['cyan'], font=('Segoe UI', 10, 'bold')).pack(pady=(2, 4))
        tk.Label(frame, text='Create your own student login', bg=C['card'], fg=C['text'], font=('Segoe UI', 19, 'bold')).pack(pady=(0, 18))

        fields = [
            ('Full Name', self.full_name, False),
            ('Username', self.username, False),
            ('Password', self.password, True),
            ('Confirm Password', self.confirm, True),
        ]
        for label, variable, secret in fields:
            tk.Label(frame, text=label).pack(anchor='w', pady=(5, 2))
            entry = tk.Entry(frame, textvariable=variable, show='*' if secret else '')
            entry.pack(fill='x', ipady=6, pady=(0, 5))

        self.status = tk.Label(frame, text='', fg='red')
        self.status.pack(anchor='w', pady=7)

        tk.Button(frame, text='CREATE ACCOUNT', command=self.create_account, width=22, height=2).pack(pady=(5, 7))
        tk.Button(frame, text='BACK TO LOGIN', command=self.back_to_login, width=22, height=2).pack()

    def create_account(self):
        if self.password.get() != self.confirm.get():
            self.status.config(text='Passwords do not match.', fg='red')
            return
        ok, message = self.db.create_user(self.full_name.get(), self.username.get(), self.password.get())
        if not ok:
            self.status.config(text=message, fg='red')
            return
        username = self.username.get().strip()
        self.login_page.show_login(username)
        self.grab_release()
        self.destroy()
        messagebox.showinfo('Account Created', f'Account for {username} was created successfully.')

    def back_to_login(self):
        self.grab_release()
        self.destroy()
        self.login_page.deiconify()
        self.login_page.lift()
        self.login_page.focus_force()


