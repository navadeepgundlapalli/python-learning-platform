        self.output = text_box(side, height=18, bg=C['black'], fg='#D1FAE5', wrap='none', size=9)
        self.output.pack(fill='both', expand=True, padx=8, pady=8)
        self.refresh_theory()

    def refresh_theory(self):
        topic = TOPICS[self.app.module][0]
        if self.task_data:
            title = self.task_data.get('title','').lower()
            for candidate in TOPICS[self.app.module]:
                if candidate.lower() in title:
                    topic = candidate
                    break
        info = THEORY[self.app.module][topic]
        guide = MODULE_GUIDES[self.app.module]
        content = []
        content.append(f'MODULE {self.app.module:02d} • {MODULES[self.app.module-1][1]}')
        content.append('')
        content.append('TOPIC: '+topic)
        content.append('')
        content.append('MODULE PURPOSE')
        content.append(guide['purpose'])
        content.append('')
        content.append('CONCEPT EXPLANATION')
        content.append(info['definition'])
        content.append('')
        content.append('KEY POINTS')
        content.extend('• '+x for x in info['key'])
        content.append('')
        content.append('WORKING EXAMPLE')
        content.append(info['example'])
        content.append('')
        content.append('COMMON MISTAKES')
        content.extend('⚠ '+x for x in info['mistakes'])
        content.append('')
        content.append('VIVA / EXAM PREPARATION')
        content.append(info['viva'])
        content.append('')
        content.append('STUDY METHOD')
        content.extend(['1. Read the concept.','2. Understand the example.','3. Modify the example.','4. Solve the task.','5. Run and test.','6. Explain the solution in your own words.'])
        set_text(self.theory, '\n'.join(content))

    def run(self):
        code = self.editor.get('1.0','end')
        if not code.strip():
            set_text(self.output, 'Nothing to run. Write a Python program first.')
            return
        set_text(self.output, 'Running program...')
        def worker():
            result = Runner.run(code)
            self.after(0, lambda:set_text(self.output, result))
        threading.Thread(target=worker, daemon=True).start()
        self.app.db.log('Ran Python code', f'{len(code.splitlines())} lines')

    def reset(self):
        self.task_data = None
        self.editor.delete('1.0','end')
        self.editor.insert('1.0', '# Start here\nprint("Hello from Py Nexus!")')
        self.task_label.config(text='Choose a task from Learn → Practice or write your own program.')
        self.clear_output()
        self.refresh_theory()

    def copy(self):
        self.clipboard_clear()
        self.clipboard_append(self.editor.get('1.0','end'))
        messagebox.showinfo('Copy','Code copied to clipboard.')

    def open_file(self):
        path = filedialog.askopenfilename(filetypes=[('Python','*.py'),('Text','*.txt'),('All files','*.*')])
        if not path:
            return
        try:
            self.editor.delete('1.0','end')
            self.editor.insert('1.0', Path(path).read_text(encoding='utf-8'))
            self.task_data = None
            self.refresh_theory()
        except OSError as error:
            messagebox.showerror('Open File', str(error))

    def save_file(self):
        path = filedialog.asksaveasfilename(defaultextension='.py', filetypes=[('Python','*.py'),('All files','*.*')])
        if not path:
            return
        try:
            Path(path).write_text(self.editor.get('1.0','end'), encoding='utf-8')
            messagebox.showinfo('Save','Python program saved successfully.')
        except OSError as error:
            messagebox.showerror('Save', str(error))

    def clear_output(self):
        set_text(self.output, '')

    def load(self, code):
        self.task_data = None
        self.editor.delete('1.0','end')
        self.editor.insert('1.0', code)
        self.clear_output()
        self.refresh_theory()

    def set_task(self, task):
        self.task_data = task
        self.task_label.config(text=f"{task['title']}\n\n{task['task']}\n\nDifficulty: {task['difficulty']}\n\nHint: {task['hint']}\n\nExpected: {task['expected']}")
        self.editor.delete('1.0','end')
        self.editor.insert('1.0', f"# {task['title']}\n# {task['task']}\n# Hint: {task['hint']}\n\n")
        self.clear_output()
        self.refresh_theory()
        self.app.db.log('Opened practice task', task['title'])


class QuizPage(tk.Frame):
    def __init__(self, parent, app):
        super().__init__(parent, bg=C['bg'])
        self.app = app
        self.module = 1
        self.questions = []
        self.index = 0
        self.score = 0
        self.answer = tk.StringVar()
        self.build()

    def build(self):
        top = card(self)
        top.pack(fill='x', pady=(0,12))
        tk.Label(top, text='ASSESSMENT CENTER', bg=C['card'], fg=C['cyan'], font=('Segoe UI',9,'bold')).pack(anchor='w', padx=18, pady=(14,2))
        tk.Label(top, text='Module-wise Python Quiz', bg=C['card'], fg='white', font=('Segoe UI',16,'bold')).pack(anchor='w', padx=18, pady=(0,10))
