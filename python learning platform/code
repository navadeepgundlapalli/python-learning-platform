            lines.append(f"{module[0]} {module[1]} | Score {item['score']}% | Completed {bool(item['completed'])}")
        set_text(self.output, '\n'.join(lines))

    def json_report(self):
        done, average, attempts, completion = self.app.db.summary()
        payload = {'platform':APP_NAME,'course_code':COURSE_CODE,'student':self.app.user.get('full_name','Student'),'completion':round(completion,2),'average_score':round(average,2),'quiz_attempts':attempts,'generated_at':datetime.now().isoformat(timespec='seconds'),'modules':[]}
        for module, item in zip(MODULES, self.app.db.progress()):
            payload['modules'].append({'id':module[0],'name':module[1],'completed':bool(item['completed']),'score':item['score'],'attempts':item['attempts']})
        path = BASE / 'reports' / ('progress_' + datetime.now().strftime('%Y%m%d_%H%M%S') + '.json')
        path.write_text(json.dumps(payload, indent=4), encoding='utf-8')
        set_text(self.output, json.dumps(payload, indent=4))
        messagebox.showinfo('JSON Report', f'Report saved to:\n{path}')

    def csv_export(self):
        path = BASE / 'exports' / ('progress_' + datetime.now().strftime('%Y%m%d_%H%M%S') + '.csv')
        with open(path, 'w', newline='', encoding='utf-8') as file:
            writer = csv.writer(file)
            writer.writerow(['Module','Completed','Score','Attempts'])
            for module, item in zip(MODULES, self.app.db.progress()):
                writer.writerow([module[1], item['completed'], item['score'], item['attempts']])
        messagebox.showinfo('CSV Export', f'CSV saved to:\n{path}')

    def final_report(self):
        self.app.show_page('Progress')
        self.app.current_page.report()


class SearchPage(tk.Frame):
    def __init__(self, parent, app):
        super().__init__(parent, bg=C['bg'])
        self.app = app
        self.build()

    def build(self):
        top = card(self)
        top.pack(fill='x', pady=(0,12))
        self.query = tk.StringVar()
        entry = tk.Entry(top, textvariable=self.query, bg=C['editor'], fg='white', insertbackground='white', relief='flat', font=('Segoe UI',10))
        entry.pack(side='left', fill='x', expand=True, padx=15, pady=15, ipady=8)
        button(top, 'Search', self.search, C['primary'], 12).pack(side='right', padx=15)
        entry.bind('<Return>', lambda event:self.search())
        self.output = text_box(self, size=9)
        self.output.pack(fill='both', expand=True)
        set_text(self.output, 'Search variables, loops, functions, lists, files, classes, SQLite, JSON, theory or practice tasks.')

    def search(self):
        query = self.query.get().strip().lower()
        if not query:
            set_text(self.output, 'Enter a search term.')
            return
        results = []
        for number, module in enumerate(MODULES, 1):
            if query in (module[1]+' '+module[2]).lower():
                results.append(f'MODULE {number}: {module[1]}\n{module[2]}')
            for topic in TOPICS[number]:
                info = THEORY[number][topic]
                blob = (topic+' '+info['definition']+' '+' '.join(info['key'])).lower()
                if query in blob:
                    results.append(f'TOPIC: Module {number} — {topic}\n{info["definition"]}\nKey idea: {info["key"][0]}')
            for task in PRACTICE[number]:
                if query in (task['title']+' '+task['task']).lower():
                    results.append('PRACTICE: '+task['title']+'\n'+task['task'])
        set_text(self.output, '\n\n'.join(results) if results else 'No results found.')


